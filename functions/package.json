{
  "name": "contact-form-function",
  "version": "1.18.0",
  "description": "GCP Cloud Function for handling portfolio contact form submissions",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "start": "npm run build && functions-framework --target=handleContactForm --port=8080",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "logs": "gcloud functions logs read handleContactForm --region=us-central1 --limit=50"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.6",
    "cors": "^2.8.5",
    "express-rate-limit": "^8.1.0",
    "form-data": "^4.0.4",
    "joi": "^17.13.3",
    "mailgun.js": "^12.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.16.5",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "20"
  },
  "keywords": [
    "gcp",
    "cloud-functions",
    "contact-form",
    "email",
    "portfolio"
  ]
}
